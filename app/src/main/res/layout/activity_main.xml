<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VF5 TikTok &amp; YouTube (Thanh Bên Phải Xe)"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="🔊 Âm thanh thanh bên phải xe VF5: Sẵn sàng (Phím vô-lăng chuyển bài)"
            android:textColor="#34D399"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMetadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TikTok • Dành Cho Bạn"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- 4 Quick Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTikTok"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FE2C55"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="TikTok"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnYouTube"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF0000"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="YouTube"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestNext"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Thử Next"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Dừng hẳn"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- OTP & Keyboard Helper Bar (Khắc phục triệt để lỗi không hiện bàn phím ảo) -->
    <LinearLayout
        android:id="@+id/otpHelperLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151E2E"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 Trợ thủ nhập mã xác thực OTP TikTok (Nếu bấm vào web không nảy phím):"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#334155"
                android:hint="Nhập mã 4-6 số tại đây..."
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnInjectOtp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#10B981"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🚀 Gửi mã"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnForceKeyboard"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#3B82F6"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⌨️ Bật phím"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- WebView Container -->
    <FrameLayout
        android:id="@+id/phoneWebViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

</LinearLayout>
